# llm-gateway configuration.
# Everything is environment-driven; there are no hardcoded prices, models,
# or provider choices anywhere in the code.

# --- Providers ---
# Comma-separated provider chain, in fallback order. The gateway tries the
# first provider; on failure it falls through to the next.
# Supported: "echo" (deterministic, offline), "bedrock" (AWS).
GATEWAY_PROVIDERS=echo

# --- Bedrock (only when "bedrock" is in GATEWAY_PROVIDERS) ---
# Model id served by the Bedrock provider. Required, no default: model
# choice is a cost decision the operator must own.
GATEWAY_BEDROCK_MODEL=
# Credentials/region resolve through the standard AWS chain
# (AWS_PROFILE, AWS_REGION, instance roles).

# --- Echo provider model name (label used for pricing lookups) ---
GATEWAY_ECHO_MODEL=echo-1

# --- Pricing ---
# Path to the pricing table (JSON). Required: a gateway that cannot price
# a request should refuse to start, not meter silently at $0.
GATEWAY_PRICING_FILE=data/pricing.example.json

# --- Ledger ---
# SQLite file where every request's usage and cost is recorded.
GATEWAY_LEDGER_PATH=gateway.db
