# llm-gateway configuration.
# Everything is environment-driven; there are no hardcoded prices, models,
# or provider choices anywhere in the code. Copy to .env and fill in secrets.
# NEVER commit a real .env — only this .example with placeholders.

# --- Providers ---
# Comma-separated provider chain, in fallback order. The gateway tries the
# first provider; if it raises a ProviderError after retries, the next
# provider in the chain is tried.
# Supported: "echo" (deterministic, offline), "bedrock" (AWS),
#            "openai" (or any OpenAI-compatible base URL), "gemini".
GATEWAY_PROVIDERS=openai,gemini,bedrock

# --- Bedrock (only when "bedrock" is in GATEWAY_PROVIDERS) ---
# Required when enabled. No default: model choice affects cost and quality.
# This is the real Claude Opus 4.8 global inference profile (Converse API).
# Discover what your account has: `aws bedrock list-inference-profiles`.
GATEWAY_BEDROCK_MODEL=global.anthropic.claude-opus-4-8
# Max output tokens per Converse call (default 2048). Raise for long research answers.
# GATEWAY_BEDROCK_MAX_TOKENS=4096
# Credentials/region resolve through the standard AWS chain (AWS_PROFILE, AWS_REGION, ...).

# --- OpenAI / OpenAI-compatible (only when "openai" is in GATEWAY_PROVIDERS) ---
GATEWAY_OPENAI_MODEL=gpt-5.5
OPENAI_API_KEY=
# GPT-5.x are reasoning models: the provider omits `temperature` and uses
# `max_completion_tokens` automatically. Tune the cap (reasoning tokens count
# against it, so don't set it too low or the visible answer comes back empty).
# GATEWAY_OPENAI_MAX_TOKENS=4096
# Optional: point at any OpenAI-compatible endpoint (Together, vLLM, llama.cpp, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Gemini (only when "gemini" is in GATEWAY_PROVIDERS) ---
# Real API id for "Gemini 3.1 Pro" (list with the models endpoint if unsure).
GATEWAY_GEMINI_MODEL=gemini-3.1-pro-preview
GOOGLE_API_KEY=
# Optional override (defaults to https://generativelanguage.googleapis.com)
# GEMINI_BASE_URL=

# --- Echo provider model name (label used for pricing lookups) ---
GATEWAY_ECHO_MODEL=echo-1

# --- Pricing ---
# Path to the pricing table (JSON). Required: a gateway that cannot price
# a request should refuse to start, not meter silently at $0.
GATEWAY_PRICING_FILE=data/pricing.example.json

# --- Ledger ---
# SQLite file where every request's usage and cost is recorded.
GATEWAY_LEDGER_PATH=gateway.db

# --- Tools (for the research agent: POST /v1/agent) ---
# web_search uses Tavily; read_url uses Jina Reader (key optional but higher rate
# limits with one); hackernews_search needs no key.
TAVILY_API_KEY=
JINA_API_KEY=
